# ─── Frontend (Next.js / Vercel) ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# Your Convex deployment's cloud URL
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# Used by the Convex CLI to target your deployment:
CONVEX_DEPLOYMENT=dev:YOUR-DEPLOYMENT

# ─── Notes ────────────────────────────────────────────────────────────────────
# .env.local is automatically added to .gitignore
# For production, set environment variables in your deployment platform
# (Vercel, AWS, etc.) using their dashboard or CLI tools
